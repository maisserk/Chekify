rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data :
             null;
    }

    function isAdmin() {
      let data = getUserData();
      let r = data != null ? data.role : '';
      return (isAuthenticated() && request.auth.token.email == "maisserk@gmail.com") ||
             (isAuthenticated() && (r == 'Administrador' || r == 'Admin' || r == 'administrador' || r == 'admin'));
    }

    function isSupervisor() {
      let data = getUserData();
      let r = data != null ? data.role : '';
      return (isAuthenticated() && (r == 'Supervisor' || r == 'supervisor' || r == 'Administrador' || r == 'Admin' || r == 'administrador' || r == 'admin')) || isAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Authorization fields are controlled by admins.
    // A user may update their profile, but cannot promote themselves
    // or move themselves to another plant.
    function authorizationFieldsUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null) &&
             request.resource.data.get('plantId', null) == resource.data.get('plantId', null);
    }

    // Rules for collections

    match /users/{uid} {
      allow read: if isAuthenticated();

      // New users created by themselves can only start as Operators.
      // Administrators can create users with managed authorization fields.
      allow create: if isAdmin() ||
                    (isOwner(uid) &&
                     request.resource.data.get('role', '') == 'Operador' &&
                     request.resource.data.get('plantId', null) == null);

      // Users can edit their profile fields, but not role or plant.
      // Administrators can manage authorization fields.
      allow update: if isAdmin() ||
                    (isOwner(uid) && authorizationFieldsUnchanged());

      allow delete: if isAdmin();
    }

    match /plants/{plantId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isSupervisor() || isAdmin());
    }

    match /areas/{areaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isSupervisor() || isAdmin());
    }

    match /equipment/{equipmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /inspections/{inspectionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /findings/{findingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /notifications/{notificationId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /push_subscriptions/{subId} {
      allow read, write: if isAuthenticated();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isSupervisor() || isAdmin());
    }
  }
}
